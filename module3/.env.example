# ConformGuard Student 3 configuration
APP_NAME=conformguard-student3
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8003

# Database (SQLite for development; switch to PostgreSQL for production)
DATABASE_URL=sqlite:////tmp/conformguard_student3.db

# Module API keys – never hard-code production values
STUDENT2_API_KEY=student2-dev-key
STUDENT4_API_KEY=student4-dev-key
ADMIN_API_KEY=admin-dev-key

# Optional LLM risk analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_RISK_ANALYSIS_ENABLED=false

# Logging
LOG_DIR=logs
RESULTS_LOG_FILE=logs/results_log.jsonl
RESULTS_LOG_INPROGRESS_FILE=logs/results_log_INPROGRESS.jsonl

DEFAULT_ALPHA=0.05
